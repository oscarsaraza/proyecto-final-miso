#!/bin/sh
# Runs the SDD gate with the first Python 3.11+ found. Fails open (exit 0) when there is none.
dir=$(cd "$(dirname "$0")" && pwd)
for py in python3 python py; do
  if command -v "$py" >/dev/null 2>&1 && "$py" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
    exec "$py" "$dir/run.py" "$@"
  fi
done
echo "sdd: Python 3.11+ not found; the gates are not enforced" >&2
exit 0
