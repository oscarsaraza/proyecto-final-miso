# Copie este archivo como backend/.env (no se sube al repositorio).

# SMS del código del asegurado:
#   console  no envía nada y la app muestra el código de prueba (por defecto).
#   twilio   envía el SMS real; requiere las tres variables de abajo y un número propio de Twilio.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Llaves del backend: obligatorias, de al menos 32 caracteres y distintas entre sí.
# Genere cada una con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
OTP_SECRET_KEY=

# Orígenes de navegador autorizados por CORS, en JSON. El portal y la API comparten origen
# (CloudFront en AWS, el proxy de Angular en local), así que normalmente queda vacío.
# CORS_ORIGINS=["https://portal.example.com"]
